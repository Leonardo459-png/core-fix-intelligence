# CORE FIX Intelligence - BACKEND

PORT=3000
NODE_ENV=development
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Microsservico de inteligencia (FastAPI)
PYTHON_API=http://127.0.0.1:8001

# Banco PostgreSQL (formato: postgresql://usuario:senha@host:porta/nome_do_banco)
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/corefix

# Autenticacao: use um texto longo e aleatorio
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio

# E-mail (confirmacao de cadastro e boas-vindas). Opcional:
# sem SMTP_HOST, o link de confirmacao aparece no terminal do backend.
# No Gmail, use uma "senha de app" (nao a senha normal da conta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CORE FIX Intelligence <seu_email@gmail.com>"

# Login social (opcional: em branco desativa)
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
